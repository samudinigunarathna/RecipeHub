{
  "expo": {
    "name": "RecipeHub",
    "slug": "RecipeHub",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "RecipeHub uses the microphone to recognize cooking voice commands.",
        "NSSpeechRecognitionUsageDescription": "RecipeHub uses speech recognition to control cooking instructions."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.samuama.RecipeHub"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-font",
      "expo-status-bar",
      "expo-speech-recognition"
    ],
    "extra": {
      "eas": {
        "projectId": "e84399cc-9b63-48b6-a2d6-d185e3b6bca1"
      }
    }
  }
}
